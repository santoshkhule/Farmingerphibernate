<!DOCTYPE hibernate-configuration PUBLIC "-//Hibernate/Hibernate Configuration DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
	<session-factory>

		<!-- H2 Driver & URL -->
		<property name="hibernate.connection.driver_class">org.h2.Driver</property>

		<!-- File-based (data persists across restarts) -->
		<property name="hibernate.connection.url">jdbc:h2:file:./farmingErpDb;AUTO_SERVER=TRUE</property>

		<!-- In-memory (data lost on restart — good for testing) -->
		<!-- <property name="hibernate.connection.url">jdbc:h2:mem:farmingErpDb;DB_CLOSE_DELAY=-1</property> -->

		<property name="hibernate.connection.username">sa</property>
		<property name="hibernate.connection.password"></property>

		<!-- H2 Dialect -->
		<property name="hibernate.dialect">org.hibernate.dialect.H2Dialect</property>

		<!-- Auto-create tables from your entities -->
		<property name="hibernate.hbm2ddl.auto">update</property>

		<!-- Helpful during development -->
		<property name="hibernate.show_sql">true</property>
		<property name="hibernate.format_sql">true</property>

		<mapping class="entity.login.com.san.farm.LoginUser" />
		<mapping class="entity.adminuser.com.san.farm.UserTypeEntity" />
		<mapping class="entity.adminuser.com.san.farm.EmployeeInfoEntity" />
		<mapping class="entity.adminuser.com.san.farm.ConfigSiteInformationEntity" />
		<mapping class="entity.adminuser.com.san.farm.ConfigCropEntity" />
		<mapping class="entity.adminuser.com.san.farm.ConfigFarmTaskEntity" />
		<mapping class="entity.adminuser.com.san.farm.AssignCropToSiteEntity" />
		<mapping class="entity.adminuser.com.san.farm.AssignCropToSiteRefEntity" />
		<mapping class="entity.adminuser.com.san.farm.AssignEmployeeToFarmEntity" />
		<mapping class="entity.adminuser.com.san.farm.SalaryProcessingEntity" />

	</session-factory>
</hibernate-configuration>
